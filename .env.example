# Copy this file to ".env" and fill in ONE provider's key. .env is gitignored.
# The app auto-detects: if OPENAI_API_KEY is set it uses OpenAI, otherwise Anthropic.
# (You can also force a provider with LLM_PROVIDER=openai|anthropic.)

# --- Option A: OpenAI -------------------------------------------------
# Get a key at https://platform.openai.com/api-keys (starts with sk-...)
OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini      # safe, cheap default. Newer if your account has access: gpt-5.4-mini, gpt-5.5

# --- Option B: Anthropic ----------------------------------------------
# Get a key at https://platform.claude.com -> API Keys (starts with sk-ant-)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6   # or claude-haiku-4-5 (cheaper/faster)

# --- Optional ---------------------------------------------------------
# LLM_PROVIDER=openai           # force a provider instead of auto-detecting
# PORT=3001
