# Copy this file to ".env" and fill in your key. .env is gitignored.
# Get a key at https://platform.claude.com -> API Keys (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-4-6   # try claude-haiku-4-5 (cheaper/faster) or claude-opus-4-8 (wittiest)
# PORT=3001
